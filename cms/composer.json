{
  "autoload": {
    "files": [
      "app/Support/helpers.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  },
  "description": "TKPRO CMS - Trang quan tri website (Laravel 12, session auth)",
  "keywords": [
    "tkpro",
    "cms",
    "laravel"
  ],
  "license": "proprietary",
  "minimum-stability": "stable",
  "name": "tkpro/cms",
  "prefer-stable": true,
  "require": {
    "laravel/framework": "^12.69",
    "php": "^8.2"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6.12",
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "phpunit"
  },
  "type": "project"
}
