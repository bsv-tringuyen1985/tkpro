# =============================================================================
# TKPRO CMS (Laravel, /admin) — copy sang .env trước khi chạy.
# Dùng CHUNG database `tkpro` với api (migrations do api sở hữu).
# =============================================================================

APP_NAME="TKPRO CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
# APP_URL là origin, không chứa /admin (routes tự thêm prefix).
APP_URL=http://localhost:8001

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database CHUNG với api ---
# Chạy local: DB_HOST=127.0.0.1 | Chạy docker: DB_HOST=mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tkpro
DB_USERNAME=tkpro
DB_PASSWORD=

# --- Session (auth bằng session, KHÔNG dùng token API) ---
# Dùng file vì bảng sessions không nằm trong migrations do api sở hữu.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Prefix route của CMS. Nginx giữ nguyên path /admin/... nên cms
# phải đăng ký toàn bộ route dưới prefix này.
ADMIN_PATH_PREFIX=admin

# --- Filesystem (media upload lưu vào storage/app/public, serve qua /storage/) ---
FILESYSTEM_DISK=public
# Local: point to the absolute api/storage/app/public directory. Docker mounts a shared volume.
PUBLIC_STORAGE_PATH=
PUBLIC_STORAGE_URL=http://localhost:8000/storage

# --- Mail (reset mật khẩu admin) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tkpro.vn"
MAIL_FROM_NAME="TKPRO CMS"

# --- Frontend (link "Xem website" trên topbar) ---
FRONTEND_URL=http://localhost:3000
