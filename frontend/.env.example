# URL API phía browser (public, dùng cho client components)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL API nội bộ dùng cho Server Components / SSR trong docker compose
# (service name của api trong docker-compose). Khi chạy local không cần đặt,
# hệ thống sẽ fallback về NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://api:8000/api/v1

# URL public của website, dùng cho sitemap.xml, robots.txt và JSON-LD/OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
