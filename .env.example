# =============================================================================
# TKPRO — biến môi trường dùng chung cho docker-compose.yml
# Copy sang .env rồi điền giá trị thật trước khi chạy `docker compose up`.
# KHÔNG commit file .env thật vào git.
# =============================================================================

# --- MySQL ---
# Mật khẩu user `tkpro` (DB_DATABASE=tkpro) dùng chung cho api + cms.
# Đổi thành chuỗi ngẫu nhiên dài trước khi deploy production.
DB_PASSWORD=tkpro_secret
# Mật khẩu root MySQL (chỉ dùng cho healthcheck/admin).
DB_ROOT_PASSWORD=root_secret

# --- Laravel (api + cms) ---
# APP_KEY: tạo bằng `php artisan key:generate --show` trong thư mục api/
# (hoặc cms/) rồi copy vào đây. Hai service DÙNG CHUNG một key.
APP_KEY=

# --- Frontend (build-time, nhúng vào bundle browser) ---
# URL mà trình duyệt gọi tới API. Mặc định đi qua nginx (port 80).
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# Public deployment URLs (set all URLs to the real domain for production)
SITE_URL=http://localhost
HTTP_BIND=0.0.0.0
HTTP_PORT=80
API_APP_URL=http://localhost
CMS_APP_URL=http://localhost
# Empty = host-only session cookie, works on localhost and custom domains.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost
