# =============================================================================
# TKPRO API (Laravel) — copy sang .env trước khi chạy.
# =============================================================================

APP_NAME="TKPRO API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database: dùng CHUNG database `tkpro` với cms ---
# Chạy local: DB_HOST=127.0.0.1 | Chạy docker: DB_HOST=mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tkpro
DB_USERNAME=tkpro
DB_PASSWORD=

# --- Auth ---
# Sanctum: origin của frontend được phép gọi API có auth.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# --- Filesystem ---
FILESYSTEM_DISK=public
PUBLIC_STORAGE_URL=http://localhost:8000/storage
# Optional absolute shared directory when API/CMS run on the same host.
PUBLIC_STORAGE_PATH=

# --- Upload media (admin/media/upload) ---
MEDIA_MAX_SIZE_KB=5120
MEDIA_MAX_DIMENSION=6000

# --- Mail (gửi mail reset mật khẩu / liên hệ) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tkpro.vn"
MAIL_FROM_NAME="TKPRO"
